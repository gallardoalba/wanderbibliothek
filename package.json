{
  "name": "wanderbibliothek",
  "version": "0.1.0",
  "private": true,
  "description": "Intercambio de libros físicos entre lectores: catálogo por ciudad, mensajería cifrada de extremo a extremo y clubes de lectura.",
  "license": "MIT",
  "author": "gallardoalba",
  "homepage": "https://github.com/gallardoalba/wanderbibliothek",
  "repository": {
    "type": "git",
    "url": "https://github.com/gallardoalba/wanderbibliothek.git"
  },
  "bugs": {
    "url": "https://github.com/gallardoalba/wanderbibliothek/issues"
  },
  "keywords": [
    "books",
    "book-exchange",
    "nextjs",
    "sqlite",
    "self-hosted"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "rm -f .data/wanderbibliothek.db .data/wanderbibliothek.db-wal .data/wanderbibliothek.db-shm",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:decrypt": "node --import tsx scripts/decrypt-backup.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "admin:2fa-off": "node --import tsx scripts/disable-2fa.ts",
    "rotate:secrets": "node --import tsx scripts/rotate-secrets.ts",
    "legal:env": "node --import tsx scripts/legal-env.ts",
    "user:verify": "node --import tsx scripts/verify-user.ts",
    "mail:test": "node --import tsx scripts/mail-test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "bench:sqlite": "node --import tsx scripts/bench-sqlite.ts",
    "test:e2e": "playwright test",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=92 --test-coverage-functions=88 --test-coverage-branches=80 \"tests/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
